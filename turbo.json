{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".browserslistrc",
    "assets/source/**",
    "content/**",
    "eslint.config.js",
    "scripts/assets/**",
    "tsconfig.base.json",
    "tsconfig.tooling.json",
    "types/**",
    "vite.shared.ts",
    "vitest.shared.ts"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "//#assets"],
      "outputs": ["dist/**"]
    },
    "build:test": {
      "dependsOn": ["^build", "//#assets"],
      "outputs": ["dist/**"]
    },
    "build:dev": {
      "dependsOn": ["^build", "//#assets"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#assets"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "//#assets"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#typecheck:root": {
      "cache": false
    },
    "//#lint:root": {
      "cache": false
    },
    "//#test:integration": {
      "cache": false
    },
    "//#assets": {
      "inputs": ["assets/source/**", "scripts/assets/**", "scripts/generate-assets.mjs"],
      "outputs": ["assets/generated/**"]
    }
  }
}
