{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".browserslistrc",
    "apps/tizen/polyfills/**",
    "apps/tizen/scripts/check-bundle.mjs",
    "assets/source/**",
    "content/**",
    "eslint.config.js",
    "scripts/assets/**",
    "scripts/frame.mjs",
    "tsconfig.base.json",
    "tsconfig.tooling.json",
    "types/**",
    "vite.shared.ts",
    "vitest.shared.ts"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "//#assets"],
      "outputs": ["dist/**"]
    },
    "build:test": {
      "dependsOn": ["^build", "//#assets"],
      "outputs": ["dist/**"]
    },
    "build:dev": {
      "dependsOn": ["^build", "//#assets"],
      "outputs": ["dist/**"]
    },
    "build:bench": {
      "dependsOn": ["^build", "//#assets"],
      "env": ["VITE_REPORT_URL", "SHMUP_BUILD_ID"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/generated/video/**",
        "$TURBO_ROOT$/scripts/v20x/**"
      ],
      "outputs": ["dist-bench/**"]
    },
    "@shmup/webos#build:bench": {
      "dependsOn": ["^build", "//#assets"],
      "env": ["VITE_REPORT_URL", "SHMUP_BUILD_ID"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/generated/video/**",
        "$TURBO_ROOT$/scripts/v20x/**",
        "$TURBO_ROOT$/apps/tizen/bench/**",
        "$TURBO_ROOT$/apps/tizen/src/**",
        "$TURBO_ROOT$/apps/tizen/scripts/**",
        "$TURBO_ROOT$/apps/tizen/vite.config.ts",
        "$TURBO_ROOT$/apps/tizen/tsconfig.json",
        "$TURBO_ROOT$/apps/tizen/package.json"
      ],
      "outputs": ["dist-bench/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#assets"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "//#assets"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#typecheck:root": {
      "cache": false
    },
    "//#lint:root": {
      "cache": false
    },
    "//#test:integration": {
      "cache": false
    },
    "//#assets": {
      "inputs": ["assets/source/**", "scripts/assets/**", "scripts/generate-assets.mjs"],
      "outputs": ["assets/generated/**"]
    }
  }
}
