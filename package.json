{
  "name": "shmup-cup",
  "version": "0.0.0",
  "private": true,
  "description": "Shmup Cup — a TypeScript 2D horizontal shoot-'em-up for Samsung Tizen TVs, the browser and Electron.",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@shmup/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --max-warnings=0 --ignore-pattern \"packages/**\" --ignore-pattern \"apps/**\" .",
    "test": "turbo run test test:integration",
    "test:integration": "vitest run --project integration",
    "content:check": "vitest run --project integration test/integration/content.test.ts",
    "test:all": "vitest run",
    "test:e2e": "turbo run build --filter=@shmup/web --filter=@shmup/tizen && playwright test --config test/e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && node scripts/clean.mjs .turbo coverage",
    "assets": "node scripts/generate-assets.mjs",
    "trig:tables": "node scripts/gen-trig-tables.mjs",
    "audio:preview": "node scripts/audio-preview.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@shmup/audio-web": "workspace:*",
    "@shmup/core": "workspace:*",
    "@shmup/input-web": "workspace:*",
    "@shmup/render-pixi": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "eslint": "catalog:",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsdoc": "^64.3.9",
    "globals": "^17.12.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
