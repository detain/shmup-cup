{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Shmup Cup — Node-side code (tests, Vite/Vitest configs)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
