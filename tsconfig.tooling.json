{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Shmup Cup — Node-side code (tests, Vite/Vitest configs)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    // Node-side TS (vite.shared.ts, tests) imports the plain-Node scripts in scripts/**/*.mjs;
    // their JSDoc provides the types (they are not type-checked themselves: no checkJs).
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
